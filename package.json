{
  "name": "github-enterprise-assessment",
  "version": "0.1.0",
  "description": "Local-first GitHub Enterprise assessment aligned to the GitHub Well-Architected Framework",
  "type": "module",
  "private": true,
  "bin": {
    "gh-waf-assess": "bin/gh-waf-assess.js"
  },
  "scripts": {
    "test": "node --test",
    "test:a11y": "node tests/accessibility.mjs",
    "docs:primer": "node -e \"require('node:fs').copyFileSync(require.resolve('@primer/css/dist/primer.css'),'docs/primer.css')\"",
    "pretest:docs": "npm run docs:primer",
    "test:docs": "node tests/docs.mjs",
    "docs:screenshots": "node bin/capture-docs-screenshots.mjs",
    "demo": "node bin/gh-waf-assess.js serve --demo",
    "start": "node bin/gh-waf-assess.js"
  },
  "dependencies": {
    "@primer/css": "^21.0.0"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
